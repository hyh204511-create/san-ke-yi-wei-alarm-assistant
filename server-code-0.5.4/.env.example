ASSISTANT_SECRET_KEY=replace-with-a-long-random-production-secret
ASSISTANT_ALLOWED_HOSTS=127.0.0.1,localhost,assistant.example.internal
ASSISTANT_CSRF_TRUSTED_ORIGINS=https://assistant.example.internal
ASSISTANT_DEBUG=1
ALLOW_DERIVED_DATA_KEYS=1

# Production must set ASSISTANT_DEBUG=0, ALLOW_DERIVED_DATA_KEYS=0 and use two
# different URL-safe base64 keys that each decode to exactly 32 bytes.
SENSITIVE_DATA_KEY=
EVIDENCE_MASTER_KEY=
REPORT_EXPORT_DIR=
EVIDENCE_EXPORT_DIR=
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=5
DATABASE_SSLMODE=require
DATA_RETENTION_DAYS=365
REPORT_EXPORT_RETENTION_DAYS=7
ASSISTANT_SECURE_SSL_REDIRECT=1
