[Unit]
Description=Three Passenger Assistant - daily retention maintenance
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=assistant
Group=assistant
WorkingDirectory=/opt/three-passenger-assistant/sandbox
ExecStart=/bin/sh -c '/opt/three-passenger-assistant/sandbox/.venv/bin/python manage.py purge_expired_exports && /opt/three-passenger-assistant/sandbox/.venv/bin/python manage.py purge_expired_voice_evidence && /opt/three-passenger-assistant/sandbox/.venv/bin/python manage.py purge_expired_operational_data'
